{
  "name": "ttg",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "preview": "npm --prefix client run preview",
    "lint": "npm --prefix client run lint",
    "check:server": "find server -name '*.js' ! -name '*.before-fix-backup.js' -print0 | xargs -0 -n1 node --check",
    "check": "bun run lint && npm run check:server && npx knip",
    "format": "prettier . --write",
    "knip": "knip"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/passport": "^1.0.17",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "knip": "^6.11.0",
    "prettier": "^3.8.3",
    "safe-stable-stringify": "^2.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.600.0",
    "compression": "^1.8.1",
    "connect-mongo": "^6.0.0",
    "cors": "^2.8.6",
    "csv-parse": "^6.2.1",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.19.0",
    "globals": "^17.6.0",
    "helmet": "^8.1.0",
    "mongodb": "^7.2.0",
    "mongoose": "^9.5.0",
    "morgan": "^1.10.1",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "passport": "^0.7.0",
    "passport-discord": "^0.1.4",
    "pino": "^10.3.1",
    "pino-pretty": "^11.0.0"
  }
}