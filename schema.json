{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ARC Raiders Master Schema",
  "type": "object",
  "required": ["id", "name", "rarity"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "rarity": {
      "enum": ["common", "uncommon", "rare", "epic", "legendary"]
    },
    "category": { "type": "string" },
    "weight": { "type": "number" },
    "vendorValue": { "type": "integer" },
    "iconName": { "type": "string" },
    "description": { "type": "string" },
    "stats": {
      "type": "object",
      "properties": {
        "magazineSize": { "type": "integer" },
        "ammoType": { "type": "string" },
        "damage": { "type": "number" }
      }
    },
    "traderData": {
      "type": "object",
      "properties": {
        "trader": { "type": "string" },
        "cost": {
          "type": "object",
          "properties": {
            "itemId": { "type": "string" },
            "quantity": { "type": "integer" }
          }
        },
        "dailyLimit": { "type": ["integer", "null"] }
      }
    },
    "projectData": {
      "type": "object",
      "properties": {
        "requiredItemIds": { "type": "array", "items": { "type": "string" } },
        "outputItemId": { "type": "string" }
      }
    }
  }
}
